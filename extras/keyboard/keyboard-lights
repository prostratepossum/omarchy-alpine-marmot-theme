DEEP_GRASS = (0x08, 0x90, 0x14)
# Snowcap on the right-hand peak.
SNOWCAP = (0xB8, 0xD4, 0xFF)
# Fireflies (yellow #e3dc5c) -- pushed toward amber so the LEDs don't go lime.
FIREFLY = (0xFF, 0xC8, 0x20)
DEVICE_MATCH = "razer blackwidow v4 low profile tkl"
OPENRGB = "/usr/bin/openrgb"
DEFAULT_PORT = 6743
FADE_SECONDS = 0.7
FRAME_DT = 1 / 45
HIT = FIREFLY
