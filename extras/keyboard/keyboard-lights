def color_for(name: str) -> tuple[int, int, int]:
    if not name:
        return NIGHT_SKY
    if name in FIREFLY_KEYS:
        return FIREFLY
    if name in SNOWCAP_KEYS:
        return SNOWCAP
    return ROW_COLORS[ROW_OF.get(name, 0)]


def hit_color(rest: tuple[int, int, int]) -> tuple[int, int, int]:
    # Fireflies already rest on the hit color, so they flash snow-white.
    if rest == FIREFLY:
        return (0xFF, 0xFF, 0xFF)
    return HIT


def summary(colors: list[tuple[int, int, int]]) -> str:
    counts = Counter(COLOR_NAMES.get(c, "other") for c in colors)
    return ", ".join(f"{n} {label}" for label, n in counts.most_common())


def hex_color(rgb: tuple[int, int, int]) -> str:
    return f"{rgb[0]:02X}{rgb[1]:02X}{rgb[2]:02X}"


def lerp(a: tuple[int, int, int], b: tuple[int, int, int], t: float) -> tuple[int, int, int]:
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    # Fade through HSV so firefly->sky stays vivid instead of going muddy.
    ah = colorsys.rgb_to_hsv(a[0] / 255, a[1] / 255, a[2] / 255)
    bh = colorsys.rgb_to_hsv(b[0] / 255, b[1] / 255, b[2] / 255)
    dh = bh[0] - ah[0]
    if dh > 0.5:
        dh -= 1
    elif dh < -0.5:
        dh += 1
    h = (ah[0] + dh * t) % 1.0
    s = ah[1] + (bh[1] - ah[1]) * t
    v = ah[2] + (bh[2] - ah[2]) * t
    r, g, bl = colorsys.hsv_to_rgb(h, s, v)
    return (int(r * 255), int(g * 255), int(bl * 255))


def parse_led_line(line: str) -> list[str]:
    payload = line[len("  LEDs:") :] if line.startswith("  LEDs:") else line
    tokens: list[str] = []
    pos = 0
    while pos < len(payload):
        if payload[pos] != " ":
            pos += 1
            continue
        pos += 1
        if pos >= len(payload):
            tokens.append("")
            break
        if payload[pos] == "'":
            pos += 1
            end = payload.find("'", pos)
            if end < 0:
                tokens.append(payload[pos:])
                break
            tokens.append(payload[pos:end])
            pos = end + 1
        else:
            end = payload.find(" ", pos)
            if end < 0:
                tokens.append(payload[pos:])
                break
            tokens.append(payload[pos:end])
            pos = end
    return tokens


def parse_devices(listing: str) -> list[dict]:
    devices: list[dict] = []
    current = None
    for raw in listing.splitlines():
        line = raw.rstrip("\n")
        m = re.match(r"^(\d+):\s+(.*)$", line)
        if m:
            current = {"id": int(m.group(1)), "name": m.group(2).strip(), "leds": []}
            devices.append(current)
            continue
        if current is not None and line.startswith("  LEDs:"):
            current["leds"] = parse_led_line(line)
    return devices


def list_devices(client: str | None = None) -> list[dict]:
    cmd = [OPENRGB]
    if client:
        cmd.extend(["--client", client])
    cmd.append("-l")
    proc = subprocess.run(cmd, check=False, capture_output=True, text=True)
    listing = proc.stdout or ""
    if "Type:" not in listing:
        listing += "\n" + (proc.stderr or "")
    devices = parse_devices(listing)
    if not devices:
        sys.stderr.write(proc.stderr or "OpenRGB did not list any devices\n")
        raise SystemExit("OpenRGB did not list any devices")
    return devices


def pick_keyboard(devices: list[dict]) -> dict:
    matches = [d for d in devices if DEVICE_MATCH in d["name"].lower()]
    if not matches:
        names = ", ".join(f"{d['id']}: {d['name']}" for d in devices)
        raise SystemExit(f"Keyboard not found. Detected: {names}")
    kb = matches[0]
    if not kb["leds"]:
        raise SystemExit(f"No LEDs listed for {kb['name']}")
    return kb


def apply_cli(kb: dict, client: str | None = None) -> None:
    colors = [hex_color(color_for(name)) for name in kb["leds"]]
    cmd = [OPENRGB]
    if client:
        cmd.extend(["--client", client])
    cmd.extend(["-d", str(kb["id"]), "-m", "Direct", "-c", ",".join(colors), "-b", "100"])
    proc = subprocess.run(cmd, check=False, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout or "openrgb failed\n")
        raise SystemExit(proc.returncode)
    print(f"Set {kb['name']}: {summary([color_for(n) for n in kb['leds']])} ({len(kb['leds'])} LEDs)")


class OpenRGBClient:
    def __init__(self, host: str = "127.0.0.1", port: int = DEFAULT_PORT) -> None:
        self.host = host
        self.port = port
        self.sock: socket.socket | None = None
        self.proto = 0

    def connect(self) -> None:
        self.sock = socket.create_connection((self.host, self.port), timeout=5)
        self.sock.settimeout(5)
        self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.send(0, 50, b"keyboard-lights\x00")
        self.send(0, 40, struct.pack("<I", 4))
        try:
            hdr, payload = self.recv_matching(40)
            if len(payload) >= 4:
                self.proto = min(4, struct.unpack_from("<I", payload)[0])
        except socket.timeout:
            self.proto = 0

    def close(self) -> None:
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None

    def send(self, dev: int, pkt_id: int, payload: bytes = b"") -> None:
        assert self.sock is not None
        header = b"ORGB" + struct.pack("<III", dev, pkt_id, len(payload))
        self.sock.sendall(header + payload)

    def recv(self) -> tuple[tuple[int, int, int], bytes]:
        assert self.sock is not None
        header = self._recvexact(16)
        magic, dev, pkt_id, size = struct.unpack_from("<4sIII", header)
        if magic != b"ORGB":
            raise RuntimeError("bad OpenRGB magic")
        payload = self._recvexact(size) if size else b""
        return (dev, pkt_id, size), payload

    def recv_matching(self, want_id: int) -> tuple[tuple[int, int, int], bytes]:
        while True:
            hdr, payload = self.recv()
            if hdr[1] == want_id:
                return hdr, payload

    def _recvexact(self, n: int) -> bytes:
        assert self.sock is not None
        buf = bytearray()
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise RuntimeError("OpenRGB server closed")
            buf.extend(chunk)
        return bytes(buf)

    def controller_count(self) -> int:
        self.send(0, 0)
        _hdr, payload = self.recv_matching(0)
        return struct.unpack_from("<I", payload)[0]

    def controller_name(self, dev: int) -> str:
        payload = struct.pack("<I", self.proto) if self.proto >= 1 else b""
        self.send(dev, 1, payload)
        _hdr, data = self.recv_matching(1)
        pos = 8  # skip data_size, type
        name_len = struct.unpack_from("<H", data, pos)[0]
        pos += 2
        return data[pos : pos + name_len].split(b"\x00", 1)[0].decode("utf-8", "replace")

    def set_custom_mode(self, dev: int) -> None:
        self.send(dev, 1100)

    def update_leds(self, dev: int, colors: list[tuple[int, int, int]]) -> None:
        body = struct.pack("<H", len(colors))
        for r, g, b in colors:
            body += struct.pack("<I", r | (g << 8) | (b << 16))
        payload = struct.pack("<I", 4 + len(body)) + body
        self.send(dev, 1050, payload)


def wait_port(host: str, port: int, timeout: float = 30.0) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=0.4):
                return
        except OSError:
            time.sleep(0.2)
    raise SystemExit(f"OpenRGB server did not start on {host}:{port}")


def start_server(port: int) -> subprocess.Popen | None:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return None
    except OSError:
        pass
    proc = subprocess.Popen(
        [
            OPENRGB,
            "--server",
            "--server-host",
            "127.0.0.1",
            "--server-port",
            str(port),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    wait_port("127.0.0.1", port)
    return proc


def find_keyboard_devices():
    from evdev import InputDevice, list_devices
    from evdev import ecodes

    found = []
    seen = set()
    for path in list_devices():
        dev = InputDevice(path)
        if "blackwidow" not in (dev.name or "").lower():
            continue
        keys = dev.capabilities().get(ecodes.EV_KEY, [])
        if ecodes.KEY_A not in keys or ecodes.KEY_SPACE not in keys:
            continue
        real = os.path.realpath(dev.path)
        if real in seen:
            continue
        seen.add(real)
        os.set_blocking(dev.fd, False)
        found.append(dev)
    if not found:
        raise SystemExit("Could not find BlackWidow evdev device")
    return found


def keycode_map():
    from evdev import ecodes

    mapping = {
        ecodes.KEY_ESC: "Key: Escape",
        ecodes.KEY_BACKSPACE: "Key: Backspace",
        ecodes.KEY_TAB: "Key: Tab",
        ecodes.KEY_CAPSLOCK: "Key: Caps Lock",
        ecodes.KEY_ENTER: "Key: Enter",
        ecodes.KEY_LEFTSHIFT: "Key: Left Shift",
        ecodes.KEY_RIGHTSHIFT: "Key: Right Shift",
        ecodes.KEY_LEFTCTRL: "Key: Left Control",
        ecodes.KEY_RIGHTCTRL: "Key: Right Control",
        ecodes.KEY_LEFTALT: "Key: Left Alt",
        ecodes.KEY_RIGHTALT: "Key: Right Alt",
        ecodes.KEY_LEFTMETA: "Key: Left Windows",
        ecodes.KEY_COMPOSE: "Key: Menu",
        ecodes.KEY_MENU: "Key: Menu",
        ecodes.KEY_SPACE: "Key: Space",
        ecodes.KEY_GRAVE: "Key: `",
        ecodes.KEY_MINUS: "Key: -",
        ecodes.KEY_EQUAL: "Key: =",
        ecodes.KEY_LEFTBRACE: "Key: [",
        ecodes.KEY_RIGHTBRACE: "Key: ]",
        ecodes.KEY_BACKSLASH: "Key: \\ (ANSI)",
        ecodes.KEY_SEMICOLON: "Key: ;",
        ecodes.KEY_APOSTROPHE: "Key: '",
        ecodes.KEY_COMMA: "Key: ,",
        ecodes.KEY_DOT: "Key: .",
        ecodes.KEY_SLASH: "Key: /",
        ecodes.KEY_SYSRQ: "Key: Print Screen",
        ecodes.KEY_SCROLLLOCK: "Key: Scroll Lock",
        ecodes.KEY_PAUSE: "Key: Pause/Break",
        ecodes.KEY_INSERT: "Key: Insert",
        ecodes.KEY_DELETE: "Key: Delete",
        ecodes.KEY_HOME: "Key: Home",
        ecodes.KEY_END: "Key: End",
        ecodes.KEY_PAGEUP: "Key: Page Up",
        ecodes.KEY_PAGEDOWN: "Key: Page Down",
        ecodes.KEY_UP: "Key: Up Arrow",
        ecodes.KEY_DOWN: "Key: Down Arrow",
        ecodes.KEY_LEFT: "Key: Left Arrow",
        ecodes.KEY_RIGHT: "Key: Right Arrow",
    }
    if hasattr(ecodes, "KEY_FN"):
        mapping[ecodes.KEY_FN] = "Key: Right Fn"
    for i in range(1, 13):
        mapping[getattr(ecodes, f"KEY_F{i}")] = f"Key: F{i}"
    for ch in "abcdefghijklmnopqrstuvwxyz":
        mapping[getattr(ecodes, f"KEY_{ch.upper()}")] = f"Key: {ch.upper()}"
    for n in range(10):
        mapping[getattr(ecodes, f"KEY_{n}")] = f"Key: {n}"
    return mapping


def acquire_lock() -> object:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/tmp/user-{os.getuid()}")
    os.makedirs(runtime, exist_ok=True)
    lock_file = open(os.path.join(runtime, "keyboard-lights.lock"), "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("keyboard-lights already running")
        raise SystemExit(0)
    return lock_file


def run_once(client: str | None = None) -> None:
    last_error = "Keyboard not found"
    for attempt in range(1, 6):
        try:
            apply_cli(pick_keyboard(list_devices(client)), client)
            return
        except SystemExit as exc:
            last_error = str(exc)
            if attempt == 5:
                raise
            time.sleep(2)
    raise SystemExit(last_error)


def run_daemon(port: int) -> None:
    server = start_server(port)
    try:
        sdk = OpenRGBClient(port=port)
        sdk.connect()
        kb_id = None
        kb_name = ""
        deadline = time.time() + 30
        while time.time() < deadline and kb_id is None:
            try:
                count = sdk.controller_count()
            except Exception:
                time.sleep(0.4)
                continue
            for idx in range(count):
                name = sdk.controller_name(idx)
                if DEVICE_MATCH in name.lower():
                    kb_id = idx
                    kb_name = name
                    break
            if kb_id is None:
                time.sleep(0.4)
        if kb_id is None:
            raise SystemExit("OpenRGB server did not expose the BlackWidow keyboard")

        rest = [color_for(name) for name in MATRIX_LEDS]
        current = list(rest)
        hits = [0.0] * len(rest)
        name_to_index = {name: i for i, name in enumerate(MATRIX_LEDS) if name}
        print(f"Set {kb_name}: {summary(rest)} ({len(rest)} LEDs)", flush=True)
        sdk.set_custom_mode(kb_id)
        sdk.update_leds(kb_id, [FIREFLY] * len(rest))
        time.sleep(0.12)
        sdk.update_leds(kb_id, current)

        try:
            from evdev import ecodes

            codes = keycode_map()
            input_devs = find_keyboard_devices()
        except Exception as exc:
            print(
                f"Reactive typing unavailable ({exc}); keeping static lighting",
                flush=True,
            )
            while True:
                time.sleep(3600)

        fd_to_dev = {d.fd: d for d in input_devs}
        print(
            "Reactive typing on "
            + ", ".join(f"{d.path} ({d.name})" for d in input_devs),
            flush=True,
        )

        logged = 0
        dirty = False
        while True:
            now = time.time()
            ready, _, _ = select.select(list(fd_to_dev), [], [], FRAME_DT)
            for fd in ready:
                dev = fd_to_dev[fd]
                try:
                    events = list(dev.read())
                except (BlockingIOError, OSError):
                    continue
                for event in events:
                    if event.type != ecodes.EV_KEY or event.value not in (1, 2):
                        continue
                    name = codes.get(event.code)
                    idx = name_to_index.get(name) if name else None
                    if logged < 8:
                        print(
                            f"key code={event.code} name={name!r} led={idx}",
                            flush=True,
                        )
                        logged += 1
                    if idx is None:
                        continue
                    hits[idx] = now
                    current[idx] = hit_color(rest[idx])
                    dirty = True
            for i, stamped in enumerate(hits):
                if stamped <= 0:
                    continue
                t = (now - stamped) / FADE_SECONDS
                if t >= 1:
                    current[i] = rest[i]
                    hits[i] = 0.0
                else:
                    current[i] = lerp(hit_color(rest[i]), rest[i], t)
                dirty = True
            if dirty:
                sdk.update_leds(kb_id, current)
                dirty = False
    finally:
        if server is not None:
            server.terminate()
            try:
                server.wait(timeout=5)
            except subprocess.TimeoutExpired:
                server.kill()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="Apply colors and exit")
    parser.add_argument("--daemon", action="store_true", help="Run reactive lighting")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args()
    _lock = acquire_lock()
    if args.once:
        run_once()
        return
    run_daemon(args.port)


if __name__ == "__main__":
    main()
