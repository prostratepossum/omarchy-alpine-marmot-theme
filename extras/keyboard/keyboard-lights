#!/usr/bin/python3
"""Wallpaper-matched Razer TKL lighting with reactive typing.

Alpine Marmot "Starwatch": the board reads top-to-bottom like the wallpaper --
night sky on the F-row, starlight and the Milky Way above the home row, blue
ridgeline, then meadow green. Arrows glow as fireflies, the nav cluster is the
snowy peak, and every keypress flashes firefly yellow.
"""

from __future__ import annotations

import argparse
import colorsys
import fcntl
import os
import re
import select
import socket
import struct
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

# LED-tuned versions of colors.toml (#030E2A bg is invisible on LEDs, so the
# sky rows use saturated blues that read as deep night blue).
